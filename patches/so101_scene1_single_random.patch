@@ -0,0 +1,29 @@
+"""Single-block direct expert: one arm picks, carries, places and parks."""
+from __future__ import annotations
+
+from ..experts.allocation import Assignment
+from ..experts.sorting import SortingExpert
+from ..tasks.sorting import regions
+
+
+class SingleBlockExpert(SortingExpert):
+    """Both arms stay in the model; only the registered active arm moves."""
+
+    def _slot(self, name):
+        extra = self.scene.extra
+        return regions.TraySlot(name=name, color=extra["color"],
+                                xy=(float(extra["slot_xy"][0]), float(extra["slot_xy"][1])),
+                                support_z=float(extra["support_z"]))
+
+    def episode(self, env):
+        entry = self.scene.objects[0]
+        slot = self._slot(self.scene.extra["slot_name"])
+        assignment = Assignment(
+            object_id=entry.name, color=entry.color, route="direct",
+            supply_arm=self.scene.extra["active_arm"],
+            destination_arm=self.scene.extra["active_arm"],
+            slot_name=slot.name,
+            reasons=("single-block scene", f"colour {entry.color} maps to {self.scene.extra['active_arm']}",
+                     f"slot {slot.name}"),
+        )
+        yield from self.direct_episode(env, assignment)
