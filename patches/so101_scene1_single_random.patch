diff -ruN a/src/bimanual/tasks/single_block/scene_sampling.py b/src/bimanual/tasks/single_block/scene_sampling.py
--- a/src/bimanual/tasks/single_block/scene_sampling.py	1969-12-31 16:00:00.000000000 -0800
+++ b/src/bimanual/tasks/single_block/scene_sampling.py	2026-10-29 03:05:49.357687849 -0700
@@ -0,0 +1,336 @@
+"""Single-block random scene construction with per-scene physical screening.
+
+The frozen sorting sampler is not reused: it samples four cubes and fixed
+trays.  This module samples one cube, one of two colours, continuous yaw on the
+square symmetry domain, and both tray positions.  Every admitted scene carries
+its own IK and collision verdicts.  The certificate still supplies the
+certified pick-point envelope; it is not treated as a per-scene place
+certificate.
+"""
+from __future__ import annotations
+
+import copy
+import math
+from contextlib import contextmanager
+
+import mujoco
+import numpy as np
+
+from ...control.ik import PoseIK
+from ...control.motion import rotation_z
+from ...control.trajectory import joint_trajectory
+from ...tasks.sorting import regions
+from ...tasks.sorting import certification
+from ...tasks.sorting.scene_sampling import (ObjectSpec, SceneGenerationError, SceneSpec)
+
+DEFAULT_MAX_ATTEMPTS = 400
+
+
+def _now_color_rgba(color):
+    return [0.85, 0.08, 0.06, 1.0] if color == "red" else [0.08, 0.25, 0.90, 1.0]
+
+
+def tray_outer_half(config):
+    inner = np.asarray(config["scene"]["trays"]["inner_half_size"], dtype=float)
+    return inner + 0.006
+
+
+def _tray_fits_table(config, xy):
+    table = config["scene"]["table"]
+    center = np.asarray(table["center_xy"], dtype=float)
+    half = np.asarray(table["half_size_xy"], dtype=float)
+    outer = tray_outer_half(config)
+    margin = float(config["sorting"].get("tray_table_margin_m", 0.02))
+    delta = np.abs(np.asarray(xy, dtype=float) - center)
+    return bool(np.all(delta + outer <= half - margin))
+
+
+def _tray_gap(config, first, second):
+    outer = tray_outer_half(config)
+    dx = max(0.0, abs(float(first[0]) - float(second[0])) - 2.0 * outer[0])
+    dy = max(0.0, abs(float(first[1]) - float(second[1])) - 2.0 * outer[1])
+    return float(math.hypot(dx, dy))
+
+
+def sample_trays(config, rng):
+    settings = config["sorting"]["tray_sampling"]
+    trays = {}
+    for color in ("red", "blue"):
+        entry = settings[color]
+        chosen = None
+        for _ in range(2000):
+            xy = (float(rng.uniform(*entry["x_m"])), float(rng.uniform(*entry["y_m"])))
+            if _tray_fits_table(config, xy):
+                chosen = xy
+                break
+        if chosen is None:
+            raise SceneGenerationError(f"no table-legal position for the {color} tray")
+        trays[color] = chosen
+    gap = _tray_gap(config, trays["red"], trays["blue"])
+    minimum = float(config["sorting"].get("tray_tray_gap_m", 0.03))
+    if gap < minimum:
+        raise SceneGenerationError(f"tray gap {gap:.4f} m below {minimum:.4f} m")
+    return trays
+
+
+def _tray_keepout_boxes(config):
+    clearance = float(config["sorting"].get("block_tray_clearance_m", 0.01))
+    half = regions.tray_inner_half(config) + 0.02 + clearance
+    boxes = []
+    for color in ("red", "blue"):
+        center = regions.tray_center(config, color)
+        boxes.append(regions.RegionSpec(f"{color}_tray_keepout",
+                                        float(center[0] - half[0]), float(center[0] + half[0]),
+                                        float(center[1] - half[1]), float(center[1] + half[1])))
+    return boxes
+
+
+def block_position_valid(config, arm, xy):
+    table = config["scene"]["table"]
+    center = np.asarray(table["center_xy"], dtype=float)
+    half = np.asarray(table["half_size_xy"], dtype=float)
+    if np.any(np.abs(np.asarray(xy, dtype=float) - center) > half - 0.06):
+        return False, "table_bounds"
+    if not regions.pick_region(config, arm).contains(xy):
+        return False, "pick_region"
+    for box in _tray_keepout_boxes(config):
+        if box.contains(xy):
+            return False, "tray_keepout"
+    return True, None
+
+
+@contextmanager
+def trays_at(env, trays):
+    bodies = {color: env.model.body(f"{color}_tray").id for color in ("red", "blue")}
+    previous = {color: env.model.body_pos[index].copy() for color, index in bodies.items()}
+    z = float(env.config["scene"]["table"]["surface_z"])
+    try:
+        for color, index in bodies.items():
+            env.model.body_pos[index] = [float(trays[color][0]), float(trays[color][1]), z]
+        mujoco.mj_forward(env.model, env.data)
+        yield
+    finally:
+        for color, index in bodies.items():
+            env.model.body_pos[index] = previous[color]
+        mujoco.mj_forward(env.model, env.data)
+
+
+def _arm_target(base, arm, joints, gripper):
+    result = np.asarray(base, dtype=float).copy()
+    offset = 0 if arm == "left" else 6
+    result[offset:offset + 5] = np.rad2deg(joints)
+    result[offset + 5] = gripper
+    return result
+
+
+def _interpolate(env, start, target, seconds):
+    frames = max(2, round(seconds * env.config["runtime"]["control_hz"]))
+    return list(joint_trajectory(start, target, seconds, env.config["runtime"]["control_hz"])), frames
+
+
+def _screen(env, arm, actions, tolerance, other_action):
+    return certification._screen(env, arm, actions, tolerance, other_action=other_action)
+
+
+def _pick_verdict(env, config, arm, xy, yaw, other_action):
+    profile = config["grasp"]
+    z = regions.resting_z(config)
+    rotation = rotation_z(yaw)
+    offset = 0 if arm == "left" else 6
+    seed = env.data.qpos[env.robot.qpos_ids[offset:offset + 5]].copy()
+    ik = PoseIK(env)
+    grasp = ik.solve(arm, [xy[0], xy[1], z], rotation, seed_rad=seed,
+                     tolerance=0.0002, rotation_tolerance=0.01)
+    if not grasp.converged:
+        return {"passed": False, "reason": "grasp_ik",
+                "position_error_m": grasp.position_error_m}
+    hover = ik.solve(arm, [xy[0], xy[1], z + profile["hover_height_m"]], rotation,
+                     seed_rad=grasp.joints_rad, tolerance=0.0002, rotation_tolerance=0.01)
+    if not hover.converged:
+        return {"passed": False, "reason": "hover_ik",
+                "position_error_m": hover.position_error_m}
+    base = env.robot.home()
+    opened = profile["open_percent"]
+    start = _arm_target(base, arm, grasp.joints_rad, opened)
+    end = _arm_target(base, arm, hover.joints_rad, opened)
+    approach, _ = _interpolate(env, start, end, profile["stage_durations_s"]["descend"])
+    lift, _ = _interpolate(env, end, start, profile["stage_durations_s"]["lift"])
+    approach_screen = _screen(env, arm, approach, profile["robot_penetration_tolerance_m"],
+                              other_action)
+    lift_screen = _screen(env, arm, lift, profile["robot_penetration_tolerance_m"], other_action)
+    return {"passed": bool(approach_screen["passed"] and lift_screen["passed"]),
+            "reason": None if approach_screen["passed"] and lift_screen["passed"] else "pick_path",
+            "approach": approach_screen, "lift": lift_screen}
+
+
+def _place_verdict(env, config, arm, slot, yaw, other_action):
+    profile = config["grasp"]
+    cube_half = regions.cube_half(config)
+    support_z = float(slot.support_z)
+    release_z = support_z + cube_half + profile["release_clearance_m"]
+    hover_height = profile.get("place_hover_height_m", profile["hover_height_m"])
+    rotation = rotation_z(yaw)
+    ik = PoseIK(env)
+    offset = 0 if arm == "left" else 6
+    seed = env.data.qpos[env.robot.qpos_ids[offset:offset + 5]].copy()
+    release = ik.solve(arm, [slot.xy[0], slot.xy[1], release_z], rotation, seed_rad=seed,
+                       tolerance=0.0002, rotation_tolerance=0.01)
+    if not release.converged:
+        return {"passed": False, "reason": "release_ik", "position_error_m": release.position_error_m}
+    hover = ik.solve(arm, [slot.xy[0], slot.xy[1], release_z + hover_height], rotation,
+                     seed_rad=release.joints_rad, tolerance=0.0002, rotation_tolerance=0.01)
+    if not hover.converged:
+        return {"passed": False, "reason": "place_hover_ik", "position_error_m": hover.position_error_m}
+    center = regions.tray_center(config, slot.color)
+    inner = regions.tray_inner_half(config)
+    extents = np.abs(rotation) @ np.full(3, cube_half)
+    contained = bool(np.all(np.abs(np.asarray(slot.xy) - center) + extents[:2] <= inner))
+    if not contained:
+        return {"passed": False, "reason": "slot_containment", "extents": extents.tolist()}
+    base = env.robot.home()
+    closed = profile["closed_percent"]
+    opened = profile["open_percent"]
+    low = _arm_target(base, arm, release.joints_rad, closed)
+    high = _arm_target(base, arm, hover.joints_rad, closed)
+    descent, _ = _interpolate(env, high, low, profile["stage_durations_s"]["lower"])
+    descent_screen = _screen(env, arm, descent, profile["robot_penetration_tolerance_m"],
+                             other_action)
+    withdraw = []
+    for sign in (-1.0, 1.0):
+        sideways_xy = np.asarray(slot.xy, dtype=float) + rotation[:, 0][:2] * profile["retreat_clearance_x_m"] * sign
+        sideways = ik.solve(arm, [sideways_xy[0], sideways_xy[1], release_z], rotation,
+                            seed_rad=release.joints_rad, tolerance=0.0005, rotation_tolerance=0.02)
+        lifted = None
+        if sideways.converged:
+            lifted = ik.solve(arm, [sideways_xy[0], sideways_xy[1], release_z + hover_height], rotation,
+                              seed_rad=sideways.joints_rad, tolerance=0.0008, rotation_tolerance=0.03)
+        if not (sideways.converged and lifted.converged):
+            withdraw.append({"sign": sign, "passed": False, "reason": "withdraw_ik"})
+            continue
+        out = _arm_target(base, arm, sideways.joints_rad, opened)
+        up = _arm_target(base, arm, lifted.joints_rad, opened)
+        release_path, _ = _interpolate(env, low, out, profile["stage_durations_s"]["release"] / 2)
+        retreat_path, _ = _interpolate(env, out, up, profile["stage_durations_s"]["release"] / 2)
+        release_screen = _screen(env, arm, release_path, profile["robot_penetration_tolerance_m"],
+                                 other_action)
+        retreat_screen = _screen(env, arm, retreat_path, profile["robot_penetration_tolerance_m"],
+                                 other_action)
+        passed = bool(release_screen["passed"] and retreat_screen["passed"])
+        withdraw.append({"sign": sign, "passed": passed,
+                         "release": release_screen, "retreat": retreat_screen})
+    passed = bool(descent_screen["passed"] and any(entry["passed"] for entry in withdraw))
+    return {"passed": passed,
+            "reason": None if passed else ("place_path" if not descent_screen["passed"] else "withdraw_path"),
+            "descent": descent_screen, "withdraw": withdraw,
+            "release_z_m": release_z, "hover_z_m": release_z + hover_height,
+            "contained": contained}
+
+
+def generate_single_scene(config, certificate, seed, color, *, env, max_attempts=DEFAULT_MAX_ATTEMPTS,
+                          trace=None):
+    if color not in ("red", "blue"):
+        raise ValueError(f"unknown colour {color!r}")
+    if env is None:
+        raise ValueError("single-block scene generation needs an environment for IK screening")
+    arm = config["sorting"]["active_arm_by_color"][color]
+    other_arm = "right" if arm == "left" else "left"
+    points = certificate.points(arm)
+    if not points:
+        raise SceneGenerationError(f"certificate has no pick points for {arm}")
+    rng = np.random.default_rng(np.random.SeedSequence([int(seed), 0x5CE1, 0 if color == "red" else 1]))
+    trays = sample_trays(config, rng)
+    effective = copy.deepcopy(config)
+    effective["scene"]["trays"] = {"red": list(trays["red"]), "blue": list(trays["blue"]),
+                                   "inner_half_size": list(config["scene"]["trays"]["inner_half_size"])}
+    other_action = regions.park_pose(config, other_arm)[0]
+    yaw_domain = config["sorting"].get("yaw_domain_degrees", [0.0, 90.0])
+    rejected = {}
+    attempts = 0
+    local_trace = []
+    with trays_at(env, trays):
+        for _ in range(int(max_attempts)):
+            attempts += 1
+            point = points[int(rng.integers(0, len(points)))]
+            jitter = float(config["sorting"].get("block_jitter_m", 0.004))
+            xy = (float(point[0]) + float(rng.uniform(-jitter, jitter)),
+                  float(point[1]) + float(rng.uniform(-jitter, jitter)))
+            yaw = float(rng.uniform(float(yaw_domain[0]), float(yaw_domain[1])))
+            entry = {"attempt": attempts, "xy": [round(xy[0], 6), round(xy[1], 6)],
+                     "yaw": round(yaw, 6), "result": None}
+            valid, reason = block_position_valid(effective, arm, xy)
+            if not valid:
+                rejected[reason] = rejected.get(reason, 0) + 1
+                entry["result"] = reason
+                local_trace.append(entry)
+                continue
+            pick = _pick_verdict(env, effective, arm, xy, yaw, other_action)
+            if not pick["passed"]:
+                rejected[pick["reason"]] = rejected.get(pick["reason"], 0) + 1
+                entry["result"] = pick["reason"]
+                local_trace.append(entry)
+                continue
+            # A single block does not need the two-cube slot offset.  The tray
+            # centre maximises clearance from all four walls for both the cube
+            # footprint and the opened gripper.
+            center = regions.tray_center(effective, color)
+            slot = regions.TraySlot(name=f"{color}_center", color=color,
+                                    xy=(float(center[0]), float(center[1])),
+                                    support_z=regions.tray_floor_top_z(effective))
+            verdict = _place_verdict(env, effective, arm, slot, yaw, other_action)
+            slot_verdicts = [{"slot": slot.name, **{key: value for key, value in verdict.items()
+                                                    if key not in ("descent", "withdraw")}}]
+            if not verdict["passed"]:
+                rejected["place_checks"] = rejected.get("place_checks", 0) + 1
+                entry["result"] = "place_checks"
+                local_trace.append(entry)
+                continue
+            chosen = slot
+            entry["result"] = "accepted"
+            entry["slot"] = chosen.name
+            local_trace.append(entry)
+            instruction = config["sorting"]["instruction_template"].format(color=color)
+            entry = ObjectSpec(name="cube_0", color=color,
+                               xy=(round(xy[0], 6), round(xy[1], 6)),
+                               yaw_degrees=round(yaw, 6), route="direct",
+                               supply_arm=arm, destination_arm=arm,
+                               orientation_degrees=round(yaw, 6),
+                               source_region=f"{arm}_source")
+            scene = SceneSpec(schema_version=1, profile="single_block_place",
+                              seed=int(seed), objects=[entry], shared_xy=(0.0, 0.0),
+                              shared_orientation_degrees=0.0, expected_transfers=[],
+                              summary=instruction, extra={
+                                  "task_type": "single_block_place",
+                                  "color": color,
+                                  "active_arm": arm,
+                                  "instruction": instruction,
+                                  "trays": {"red": [round(trays["red"][0], 6), round(trays["red"][1], 6)],
+                                            "blue": [round(trays["blue"][0], 6), round(trays["blue"][1], 6)]},
+                                  "slot_name": chosen.name,
+                                  "slot_xy": [round(float(chosen.xy[0]), 6), round(float(chosen.xy[1]), 6)],
+                                  "support_z": float(chosen.support_z),
+                                  "block_xy": [round(xy[0], 6), round(xy[1], 6)],
+                                  "yaw_degrees": round(yaw, 6),
+                                  "checks": {
+                                      "sampler_attempts": attempts,
+                                      "pick": {key: value for key, value in pick.items()
+                                               if key not in ("approach", "lift")},
+                                      "slots": slot_verdicts,
+                                      "tray_gap_m": round(_tray_gap(config, trays["red"], trays["blue"]), 6),
+                                  },
+                              })
+            scene.sha256 = scene.digest()
+            if trace is not None:
+                trace.extend(local_trace)
+            return scene
+    if trace is not None:
+        trace.extend(local_trace)
+    raise SceneGenerationError(
+        f"no legal single-block scene for seed {seed} colour {color} after {attempts} attempts; "
+        f"rejections {rejected}")
+
+
+def scene_certificate_digest(certificate):
+    import hashlib
+    import json
+    payload = json.dumps(certificate.data, sort_keys=True, separators=(",", ":"), default=str).encode()
+    return hashlib.sha256(payload).hexdigest()
