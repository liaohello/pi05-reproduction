+                status = result.detail.get("status") or {}
+                fingerprint = env.task.initial_fingerprint
+                initial_metrics = env.task.initial_metrics
+                row = {
+                    "attempt": episode_index + 1,
+                    "phase": "physical_pilot",
+                    "layout_index": layout_index,
