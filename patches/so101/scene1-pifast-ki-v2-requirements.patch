+    def joint_loss(
+        self,
+        rng,
+        observation,
+        actions,
+        action_region_mask,
+        *,
+        fast_ce_weight,
+        train=False,
+        ki=True,
+    ):
+        """Return the explicit Scene1 joint loss with 12-D flow supervision."""
+        if fast_ce_weight is None:
+            raise ValueError("fast_ce_weight must be set explicitly")
+        weight = float(fast_ce_weight)
+        if not math.isfinite(weight) or weight < 0.0:
+            raise ValueError("fast_ce_weight must be finite and non-negative")
+        flow_mse_12d, fast_ce = self.compute_losses(
