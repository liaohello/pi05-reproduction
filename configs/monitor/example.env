# 本地训练监控配置示例（只读页面）。
# 复制为 configs/monitor/local.env（已被 .gitignore 忽略），或直接导出下列变量：
#   set -a && source configs/monitor/local.env && set +a
# 入口：./scripts/run.sh watch ；页面默认只在 http://127.0.0.1 上提供。

# --- 必填：要观察的运行目录 -------------------------------------------------
# 训练脚本写入 train_*.log / config_*.json / run_*.json / evaluation/ 的那一层，
# 也可以指向其父目录（例如 runs/so101）由页面列出多个运行。
PI05_WATCH_RUNS_DIR=

# --- 连接参数（默认仅本机）-------------------------------------------------
PI05_WATCH_HOST=127.0.0.1
PI05_WATCH_PORT=8765
# 改成非本机地址前必须想清楚：页面会暴露训练指标，且没有任何鉴权。
# PI05_WATCH_ALLOW_NON_LOOPBACK=1

# --- 读取节奏与判定阈值 -----------------------------------------------------
# 前端轮询间隔的初始值（毫秒，页面里还能再改）
PI05_WATCH_POLL_MS=5000
# 日志超过这么多秒没有增长就标为「记录中断」，不会判成失败
PI05_WATCH_STALE_S=180

# --- 可选：指定当前运行与门禁产物 -------------------------------------------
# 运行目录相对 PI05_WATCH_RUNS_DIR 的名字，例如 so101/e4t
PI05_WATCH_RUN=
# checkpoint 门禁汇总；缺省读 experiments/so101/e4t-openloop.json
# PI05_WATCH_GATE_FILE=
