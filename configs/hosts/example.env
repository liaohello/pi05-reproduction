# Deployment environment template.
# Copy to .env.local, fill in your own machine, then: set -a && source .env.local && set +a
# Nothing in this file is a credential; the SSH key itself stays outside the repository.

# --- remote host -------------------------------------------------------------
PI05_REMOTE_HOST=
PI05_REMOTE_PORT=22
PI05_REMOTE_USER=
PI05_SSH_KEY_PATH=~/.ssh/id_ed25519

# --- remote work directory ---------------------------------------------------
PI05_REMOTE_ROOT=
PI05_RUNS_DIR=
PI05_ARTIFACT_DIR=
PI05_LOG_DIR=

# --- assets (kept outside Git) ----------------------------------------------
# Directory holding the pi05_libero checkpoint
PI05_CKPT=
# .../pi05_libero/assets/physical-intelligence/libero/norm_stats.json
PI05_NORM_STATS=
# PaliGemma tokenizer file
PI05_TOKENIZER=
# Optional: LeRobot / raw HDF5 datasets used for fine-tuning
PI05_LEROBOT_DATA=
PI05_HDF5_DATA=

# --- optional: local third-party source tree for hash verification -----------
# PI05_OPENPI_SRC=/path/to/openpi
# PI05_SOURCE_MANIFEST=/path/to/manifest.json
